{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore(release): v${version}",
    "push": true,
    "pushArgs": ["--follow-tags"],
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireCommits": true,
    "requireUpstream": true,
    "tag": true,
    "tagAnnotation": "Release v${version}",
    "tagName": "v${version}"
  },
  "github": {
    "autoGenerate": false,
    "draft": false,
    "preRelease": false,
    "release": true,
    "releaseName": "v${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "//": "false on purpose. Publication belongs to .github/workflows/release.yml, which uses npm trusted publishing over OIDC and so produces a provenance attestation. A local `pnpm release` versions, writes the changelog and pushes the tag; the tag triggers the workflow. Setting this true would publish a second, unsigned copy from whatever credentials the laptop happens to hold, and race the workflow for the same version.",
    "publish": false
  },
  "hooks": {
    "before:init": ["pnpm typecheck", "pnpm test", "pnpm build"],
    "after:release": "echo '✅ Released ${name} v${version}'"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true,
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "Features" },
          { "type": "fix", "section": "Bug Fixes" },
          { "type": "perf", "section": "Performance" },
          { "type": "refactor", "section": "Refactoring" },
          { "type": "docs", "section": "Documentation" },
          { "type": "test", "section": "Tests" },
          { "type": "cicd", "section": "CI/CD" },
          { "type": "chore", "hidden": true }
        ]
      }
    }
  }
}
