{
  "name": "@guillem_puche/mastra-effect",
  "version": "0.0.0",
  "description": "Mastra server adapter for the Effect v4 HTTP layer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c .oxlintrc.json .",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "lint-secrets": "secretlint --secretlintignore .secretlintignore \"**/*\"",
    "lint-deps": "syncpack lint",
    "fix-deps": "syncpack fix"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/server": "^1.68.0",
    "fetch-to-node": "^2.1.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.64.0-0 <2.0.0-0",
    "effect": ">=4.0.0-rc.116 <5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@mastra/core": "^1.68.0",
    "@mastra/mcp": "^1.18.0",
    "@mastra/server-adapters-test-suite": "0.1.0-alpha.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^22.20.1",
    "effect": "4.0.0-rc.116",
    "lefthook": "^2.1.14",
    "oxlint": "^1.0.0",
    "publint": "^0.3.24",
    "release-it": "^21.1.0",
    "secretlint": "^13.0.5",
    "syncpack": "^14.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "4.1.11",
    "zod": "^4.6.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "mastra",
    "effect",
    "effect-ts",
    "server-adapter",
    "http"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillempuche/mastra-effect.git"
  },
  "bugs": {
    "url": "https://github.com/guillempuche/mastra-effect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4"
}
